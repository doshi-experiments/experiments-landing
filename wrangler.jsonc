{
  // Cloudflare Worker serving only static assets — no server code.
  // `npm run build` writes dist/, and Wrangler uploads it.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "experiments-landing",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
